{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testry.invalid/schemas/interrupted-run.schema.json",
  "title": "testry runs show (interrupted run)",
  "description": "Output of `testry runs show <run-id> --format json` for a run without a terminal record. It has no outcome: an interrupted run verified nothing.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "state": {
      "const": "interrupted"
    },
    "detail": {
      "type": "string"
    },
    "run": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "plan_id": {
          "$ref": "#/$defs/fingerprint"
        },
        "mode": {
          "enum": [
            "affected",
            "full",
            "shadow"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "workspace_id": {
          "type": "string"
        },
        "lease_id": {
          "$ref": "#/$defs/run_id"
        },
        "provider": {
          "enum": [
            "host",
            "devcontainer_cli"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "started_at_unix": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "plan_id",
        "mode",
        "scope",
        "workspace_id",
        "started_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "state",
    "detail",
    "run"
  ],
  "additionalProperties": false,
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
